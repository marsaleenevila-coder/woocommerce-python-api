{
  "info": {
    "name": "Norevia WooCommerce API",
    "description": "API testing collection for the Norevia WooCommerce store using WooCommerce REST API v3 and OAuth 1.0 authentication.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "oauth1",
    "oauth1": [
      {
        "key": "consumerKey",
        "value": "{{consumerKey}}",
        "type": "string"
      },
      {
        "key": "consumerSecret",
        "value": "{{consumerSecret}}",
        "type": "string"
      },
      {
        "key": "signatureMethod",
        "value": "HMAC-SHA1",
        "type": "string"
      },
      {
        "key": "addParamsToHeader",
        "value": true,
        "type": "boolean"
      },
      {
        "key": "version",
        "value": "1.0",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Products",
      "item": [
        {
          "name": "Retrieve All Products",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/wp-json/wc/v3/products?per_page=10",
              "host": ["{{baseUrl}}"],
              "path": ["wp-json", "wc", "v3", "products"],
              "query": [
                {
                  "key": "per_page",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Search Products by Name",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/wp-json/wc/v3/products?search={{searchTerm}}",
              "host": ["{{baseUrl}}"],
              "path": ["wp-json", "wc", "v3", "products"],
              "query": [
                {
                  "key": "search",
                  "value": "{{searchTerm}}"
                }
              ]
            }
          }
        },
        {
          "name": "Search Products by SKU",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/wp-json/wc/v3/products?sku={{productSku}}",
              "host": ["{{baseUrl}}"],
              "path": ["wp-json", "wc", "v3", "products"],
              "query": [
                {
                  "key": "sku",
                  "value": "{{productSku}}"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Retrieve All Orders",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/wp-json/wc/v3/orders?per_page=10",
              "host": ["{{baseUrl}}"],
              "path": ["wp-json", "wc", "v3", "orders"],
              "query": [
                {
                  "key": "per_page",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Retrieve Order by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/wp-json/wc/v3/orders/{{orderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["wp-json", "wc", "v3", "orders", "{{orderId}}"]
            }
          }
        },
        {
          "name": "Search Orders by Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/wp-json/wc/v3/orders?status={{orderStatus}}",
              "host": ["{{baseUrl}}"],
              "path": ["wp-json", "wc", "v3", "orders"],
              "query": [
                {
                  "key": "status",
                  "value": "{{orderStatus}}"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Customers",
      "item": [
        {
          "name": "Retrieve All Customers",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/wp-json/wc/v3/customers?per_page=10",
              "host": ["{{baseUrl}}"],
              "path": ["wp-json", "wc", "v3", "customers"],
              "query": [
                {
                  "key": "per_page",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Retrieve Customer by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/wp-json/wc/v3/customers/{{customerId}}",
              "host": ["{{baseUrl}}"],
              "path": ["wp-json", "wc", "v3", "customers", "{{customerId}}"]
            }
          }
        },
        {
          "name": "Search Customers by Email",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/wp-json/wc/v3/customers?email={{customerEmail}}",
              "host": ["{{baseUrl}}"],
              "path": ["wp-json", "wc", "v3", "customers"],
              "query": [
                {
                  "key": "email",
                  "value": "{{customerEmail}}"
                }
              ]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "{{baseUrl}}"
    }
  ]
}
